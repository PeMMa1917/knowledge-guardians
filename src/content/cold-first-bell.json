  "journal": [
    {
      "id": "j.clearbay.use",
      "claimKind": "observation",
      "text": "I checked both routes with measured loads and matched two accounts from the same first bell. A later repair changed West. Tarin used the handling limit and the public wait on the notice."
    }
  ],
  "hints": [
    {
      "id": "h.clearbay.compare.1",
      "objective": "clearbay.compare",
      "depth": 1,
      "text": "The marked bay is near the Cold Store’s middle walk. There are two paper records to the west."
    },
    {
      "id": "h.clearbay.compare.2",
      "objective": "clearbay.compare",
      "depth": 2,
      "text": "Try the same cart with and without its helper. Try the hand parcel at West. Its older margin may have moved."
    },
    {
      "id": "h.clearbay.compare.3",
      "objective": "clearbay.compare",
      "depth": 3,
      "text": "Set the visitor’s first bell next to the duty entry for that same bell. The later repair belongs beneath them."
    },
    {
      "id": "h.clearbay.compare.4",
      "objective": "clearbay.compare",
      "depth": 4,
      "text": "Finish all four trials and check both paper records. At the bay pin the dated records, chalk both current limits and fold the name behind the public wait."
    },
    {
      "id": "h.clearbay.use.1",
      "objective": "clearbay.use",
      "depth": 1,
      "text": "One crew can hold a wide gate at second bell. A hand parcel needs less room."
    },
    {
      "id": "h.clearbay.use.2",
      "objective": "clearbay.use",
      "depth": 2,
      "text": "Both plans can keep the waiting time and the width limit visible."
    },
    {
      "id": "h.clearbay.use.3",
      "objective": "clearbay.use",
      "depth": 3,
      "text": "North takes the wide cart and the helper together. West can take the hand parcel first with a relay for the cart."
    },
    {
      "id": "h.clearbay.use.4",
      "objective": "clearbay.use",
      "depth": 4,
      "text": "Post either notice. Meet Tarin by North’s wide-rail receipt or West’s relay rack. The check ends after they bring a real load through."
    }
  ]
