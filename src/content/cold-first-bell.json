  "dialogue": [
    {
      "id": "clearbay.duty-book",
      "speaker": "clearbay-marret",
      "text": "Keeper Marret opens the duty book to Year 11. “At first bell, North is kept for the handling crew. Wide deliveries use it at second bell when I can stand here.” In a different ink, Year 19 moves West’s post one square into the old opening. Both entries name the same two gates.",
      "historicalLabel": "fictional-world",
      "claimKind": "observation",
      "options": [
        {
          "text": "Lift a copy of the first-bell entry and its later repair tab.",
          "if": {
            "all": [
              {
                "flag": "preserved.arrived",
                "eq": true
              },
              {
                "not": {
                  "flagSet": "clearbay.duty"
                }
              }
            ]
          },
          "effects": [
            {
              "setFlag": "clearbay.duty",
              "value": true
            }
          ],
          "next": "clearbay.duty-copied"
        }
      ]
    },
    {
      "id": "clearbay.duty-copied",
      "speaker": "clearbay-marret",
      "text": "The date stays on the duty entry. The repair tab folds over its footer. Marret has a shelf for books that are heavier than the things they govern.",
      "historicalLabel": "fictional-world",
      "claimKind": "observation"
    },
    {
      "id": "clearbay.visitor-note",
      "speaker": "clearbay-tarin",
      "text": "A visitor’s Year 11 stub says, “I came at first bell. West let me in with a parcel. The cart beside me had to wait.” The family loaned the stub for this review. A folded margin holds their name and asks for their waiting time to be kept on the public copy.",
      "historicalLabel": "fictional-world",
      "claimKind": "observation",
      "options": [
        {
          "text": "Clip a copy of the visitor’s first-bell account to the work rack.",
          "if": {
            "all": [
              {
                "flag": "preserved.arrived",
                "eq": true
              },
              {
                "not": {
                  "flagSet": "clearbay.request"
                }
              }
            ]
          },
          "effects": [
            {
              "setFlag": "clearbay.request",
              "value": true
            }
          ],
          "next": "clearbay.note-copied"
        }
      ]
    },
    {
      "id": "clearbay.note-copied",
      "speaker": "clearbay-tarin",
      "text": "Tarin rests a finger on the word “cart”. “That is one visitor and the cart they actually saw. I can carry their request without copying a whole family onto the wall.”",
      "historicalLabel": "fictional-world",
      "claimKind": "observation"
    },
    {
