    {
      "id": "clearbay.north-reader",
      "speaker": "clearbay-tarin",
      "text": "Tarin returns at second bell. The cart and its helper fit through North together. Marret has the same crew spot as in the duty entry. A visitor who came early reads the waiting time and puts down their parcel beside the bench.",
      "historicalLabel": "fictional-world",
      "claimKind": "observation",
      "options": [
        {
          "text": "Hold the measured line while Tarin brings the cart through.",
          "if": {
            "all": [
              {
                "flag": "preserved.arrived",
                "eq": true
              },
              {
                "flag": "clearbay.layout",
                "eq": "north"
              },
              {
                "not": {
                  "flagSet": "clearbay.checked"
                }
              }
            ]
          },
          "effects": [
            {
              "setFlag": "clearbay.checked",
              "value": "north"
            }
          ],
          "next": "clearbay.north-after"
        }
      ]
    },
    {
      "id": "clearbay.north-after",
      "speaker": "clearbay-tarin",
      "text": "The wheels go through with a square left for the helper. Tarin ties a wide-cart tab to North. Early hand parcels wait on the bench until the crew arrives.",
      "historicalLabel": "fictional-world",
      "claimKind": "observation"
    },
    {
      "id": "clearbay.west-reader",
      "speaker": "clearbay-tarin",
      "text": "Tarin arrives at first bell with a hand parcel. It and the helper fit through West. The cart stays at the relay rack until a porter takes it to North at second bell. “I’m glad my name doesn’t have to get through for my parcel to get through.”",
      "historicalLabel": "fictional-world",
      "claimKind": "observation",
      "options": [
        {
          "text": "Pass Tarin’s parcel through and tie the cart to its second-bell ticket.",
          "if": {
            "all": [
              {
                "flag": "preserved.arrived",
                "eq": true
              },
              {
                "flag": "clearbay.layout",
                "eq": "west"
              },
              {
                "not": {
                  "flagSet": "clearbay.checked"
                }
              }
            ]
          },
          "effects": [
            {
              "setFlag": "clearbay.checked",
              "value": "west"
            }
          ],
          "next": "clearbay.west-after"
        }
      ]
    },
    {
      "id": "clearbay.west-after",
      "speaker": "clearbay-tarin",
      "text": "The hand parcel reaches its shelf at first bell. The wide cart has a staffed relay ticket with the measured restriction clipped above it.",
      "historicalLabel": "fictional-world",
      "claimKind": "observation"
    }
