{
  "dialogue": [
    {
      "id": "last-turn.turn",
      "speaker": "narrator",
      "text": "As the square empties, Derva turns a speaking slate face down and stays by the rail. Hesper looks back from the forge road. Orrin draws a line on his sheet. The slate lies still.",
      "historicalLabel": "fictional-world",
      "options": [
        {
          "text": "Lift Derva’s slate and check both faces.",
          "effects": [
            {
              "setFlag": "last-turn.turned",
              "value": "lifted"
            }
          ]
        },
        {
          "text": "Leave the slate on the rail."
        }
      ]
    },
    {
      "id": "last-turn.post",
      "speaker": "narrator",
      "text": "Both slips describe a slate turned face down. Hesper is keeping space for a worker who missed a turn. Orrin is trying to clear the buyers’ queue. Derva says, “I’ll give my account here, or leave it signed for the Study. Keep where I stood with it.”",
      "historicalLabel": "fictional-world",
      "options": [
        {
          "text": "Hold the queue for Derva’s one turn and clip her account on the rail.",
          "effects": [
            {
              "setFlag": "last-turn.plan",
              "value": "floor"
            },
            {
              "giveItem": "item.last-turn.docket"
            }
          ]
        },
        {
          "text": "Release the queue and lodge a dated intake for Derva’s account.",
          "effects": [
            {
              "setFlag": "last-turn.plan",
              "value": "file"
            },
            {
              "giveItem": "item.last-turn.docket"
            }
          ]
        },
        {
          "text": "Leave the slate and the two slips together for now."
        }
      ]
    },
    {
      "id": "last-turn.intake",
      "speaker": "narrator",
      "text": "The tally stub marks the end of the first speaking list. Its second tab points to Derva’s sealed account. She signed it for the Study and asked the keeper to keep the two dates visible.",
      "historicalLabel": "fictional-world",
      "options": [
        {
          "text": "Open her intake sleeve and slip the signed account under its own date.",
          "effects": [
            {
              "setFlag": "last-turn.study.checked",
              "value": true
            }
          ]
        },
        {
          "text": "Leave the sleeve at the Study stairs."
        }
      ]
    }
  ],
