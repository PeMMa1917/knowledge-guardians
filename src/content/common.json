  "awards": [
    {
      "id": "award.dates-have-kinds",
      "kind": "concept-award",
      "name": "Dates Have Kinds",
      "earnedBy": "You inspected all three 'first' exhibits and used the Date-Kind Lens to separate a patent date, a build date and an object date.",
      "criteria": [
        "crit.evidence.date-kinds"
      ],
      "when": {
        "all": [
          {
            "num": "count.inspected",
            "gte": 3
          },
          {
            "num": "count.lens",
            "gte": 2
          }
        ]
      }
    },
    {
      "id": "skill.fair-test-1",
