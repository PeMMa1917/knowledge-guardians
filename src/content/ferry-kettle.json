  "dialogue": [
    {
      "id": "ferry.kettle.offer",
      "speaker": "ferry-cook",
      "historicalLabel": "fictional-world",
      "text": "Enna Bridgel keeps a warm pot for people at the landing. “Two at the first bell want to take a cup right to the boat. Four will be here later. The next shift has six who can stay. I have six measures to use in either case. Let me call a shift from the trial bench.”",
      "options": [
        {
          "text": "Take the practice ladle.",
          "next": "ferry.kettle.shift"
        },
        {
          "text": "Walk on for now."
        }
      ]
    },
    {
      "id": "ferry.kettle.after",
      "speaker": "ferry-cook",
      "historicalLabel": "fictional-world",
      "text": "Enna wipes the rim. “Keep the serving card where it is. You can try the other shift next. I’ll leave this one posted until the new cups are ready.”",
      "options": [
        {
          "text": "Ask Enna for a fresh shift card.",
          "next": "ferry.kettle.shift"
        },
        {
          "text": "Leave the last serving card in place."
        }
      ]
    },
    {
      "id": "ferry.kettle.active",
      "speaker": "ferry-cook",
      "historicalLabel": "fictional-world",
      "text": "“The shift card is on the slate. Try the two pots and open the cups. Tell me which bench to set before the crew comes.”"
    },
    {
      "id": "ferry.kettle.unread",
      "speaker": "ferry-cook",
      "historicalLabel": "fictional-world",
      "text": "“Before we try another shift, look at the waiting bench and see who has a cup.”"
    },
    {
      "id": "ferry.kettle.shift",
      "speaker": "ferry-cook",
      "historicalLabel": "fictional-world",
      "text": "“The kettle takes six measures. The small pot is ready at the first bell and leaves the rest for a second turn. A full pot takes until the second. Today we can try either arrival card without spending any real stock.”",
      "options": [
        {
          "text": "Hang the card for the early boat and the bench queue.",
          "next": "ferry.kettle.marked-busy",
          "effects": [
            {
              "setFlag": "kettle.shift",
              "value": "busy"
            },
            {
              "setFlag": "kettle.active",
              "value": true
            },
            {
              "setFlag": "kettle.whole",
              "value": false
            },
            {
              "setFlag": "kettle.split",
              "value": false
            }
          ]
        },
        {
          "text": "Hang the card for six people who stay until the second bell.",
          "next": "ferry.kettle.marked-steady",
          "effects": [
            {
              "setFlag": "kettle.shift",
              "value": "steady"
            },
            {
              "setFlag": "kettle.active",
              "value": true
            },
            {
              "setFlag": "kettle.whole",
              "value": false
            },
            {
              "setFlag": "kettle.split",
              "value": false
            }
          ]
        },
        {
          "text": "Leave both shift cards on the hook."
        }
      ]
    },
    {
      "id": "ferry.kettle.marked-busy",
      "speaker": "ferry-cook",
      "historicalLabel": "fictional-world",
      "text": "The first peg holds two cups for people on the early boat. The bench peg holds four for the later crew. The first crew has to leave at the first bell."
    },
    {
      "id": "ferry.kettle.marked-steady",
      "speaker": "ferry-cook",
      "historicalLabel": "fictional-world",
      "text": "The first-bell peg is bare. All six cups will be requested at the bench at the second bell."
    },
    {
      "id": "ferry.kettle.trial",
      "speaker": "ferry-cook",
      "historicalLabel": "fictional-world",
      "text": "The trial cups are dry markers. You can lift each on the bell at which the pot can fill it. The same six measures stay on the tray.",
      "options": [
        {
          "text": "Put six measures in one pot.",
          "next": "ferry.kettle.whole-run",
          "if": {
            "flag": "kettle.active",
            "eq": true
          }
        },
        {
          "text": "Set two measures on the small-pot mark.",
          "next": "ferry.kettle.split-run",
          "if": {
            "flag": "kettle.active",
            "eq": true
          }
        },
        {
          "text": "Arrange the real serving bench.",
          "next": "ferry.kettle.choose",
          "if": {
            "all": [
              {
                "flag": "kettle.active",
                "eq": true
              },
              {
                "all": [
                  {
                    "flag": "kettle.whole",
                    "eq": true
                  },
                  {
                    "flag": "kettle.split",
                    "eq": true
                  }
                ]
              }
            ]
          }
        },
        {
          "text": "Leave the kettle on its hook."
        }
      ]
    },
    {
      "id": "ferry.kettle.whole-run",
      "speaker": "ferry-cook",
      "historicalLabel": "fictional-world",
      "text": "The full pot takes the two chalk counts. The two early cup rings stay empty until you lift the pot.",
      "options": [
        {
          "text": "Lift the full pot at the second bell.",
          "next": "ferry.kettle.busy-whole",
          "if": {
            "all": [
              {
                "flag": "kettle.active",
                "eq": true
              },
              {
                "flag": "kettle.shift",
                "eq": "busy"
              }
            ]
          },
          "effects": [
            {
              "setFlag": "kettle.whole",
              "value": true
            }
          ]
        },
        {
          "text": "Lift the full pot at the second bell.",
          "next": "ferry.kettle.steady-whole",
          "if": {
            "all": [
              {
                "flag": "kettle.active",
                "eq": true
              },
              {
                "flag": "kettle.shift",
                "eq": "steady"
              }
            ]
          },
          "effects": [
            {
              "setFlag": "kettle.whole",
              "value": true
            }
          ]
        },
        {
          "text": "Leave the kettle on its hook."
        }
      ]
    },
    {
      "id": "ferry.kettle.split-run",
      "speaker": "ferry-cook",
      "historicalLabel": "fictional-world",
      "text": "The small pot comes up to the first chalk line. You set two filled markers on the rail, keeping four dry markers for another heat.",
      "options": [
        {
          "text": "Set down two cups and start the second pot for four.",
          "next": "ferry.kettle.split-second",
          "if": {
            "flag": "kettle.active",
            "eq": true
          }
        },
        {
          "text": "Leave the kettle on its hook."
        }
      ]
    },
    {
      "id": "ferry.kettle.split-second",
      "speaker": "ferry-cook",
      "historicalLabel": "fictional-world",
      "text": "The second pot takes a fresh turn at the hearth. The two cups on the rail hold their first-bell tag.",
      "options": [
        {
          "text": "Ladle the other four at the second bell.",
          "next": "ferry.kettle.busy-split",
          "if": {
            "all": [
              {
                "flag": "kettle.active",
                "eq": true
              },
              {
                "flag": "kettle.shift",
                "eq": "busy"
              }
            ]
          },
          "effects": [
            {
              "setFlag": "kettle.split",
              "value": true
            }
          ]
        },
        {
          "text": "Ladle the other four at the second bell.",
          "next": "ferry.kettle.steady-split",
          "if": {
            "all": [
              {
                "flag": "kettle.active",
                "eq": true
              },
              {
                "flag": "kettle.shift",
                "eq": "steady"
              }
            ]
          },
          "effects": [
            {
              "setFlag": "kettle.split",
              "value": true
            }
          ]
        },
        {
          "text": "Leave the kettle on its hook."
        }
      ]
    },
    {
      "id": "ferry.kettle.busy-whole",
      "speaker": "ferry-cook",
      "historicalLabel": "fictional-world",
      "text": "One heat fills six at the second bell. Four people at the bench take a cup. The early boat has gone, and the two rings for that crew remain empty. Two servings stay in the pot."
    },
    {
      "id": "ferry.kettle.busy-split",
      "speaker": "ferry-cook",
      "historicalLabel": "fictional-world",
      "text": "Two heats fill the same six. Two people take their cups to the early boat; the other four collect theirs at the bench. A second turn at the hearth needs another tending round."
    },
    {
      "id": "ferry.kettle.steady-whole",
      "speaker": "ferry-cook",
      "historicalLabel": "fictional-world",
      "text": "The full pot comes up at the second bell, when all six people reach the bench. One heat and no wait on the serving tray."
    },
    {
      "id": "ferry.kettle.steady-split",
      "speaker": "ferry-cook",
      "historicalLabel": "fictional-world",
      "text": "Two filled cups stand until the second bell. The bench gets all six, but the first two are already cooler. A second turn at the hearth needs more tending."
    },
