    {
      "id": "ferry.kettle.posted",
      "speaker": "ferry-cook",
      "historicalLabel": "fictional-world",
      "text": "Enna sets the bowls out as you asked. Follow her service card to the low bench and see what the people leave in the cup rings."
    },
    {
      "id": "market.kettle.source",
      "speaker": "market-clerk",
      "historicalLabel": "fictional-world",
      "text": "Dagny folds your card onto the market order. “The ferry counted what it could pour and who could take a cup. Here we carry lidded cups down the rain lane. The covered table has six spaces, but a carrier takes only four at once. I need to know if ‘six ready’ will make the last pair get overlooked.”",
      "options": [
        {
          "text": "Clip the ferry’s two counts beside the local carrying note.",
          "if": {
            "item": "item.kettle.service-card"
          },
          "effects": [
            {
              "setFlag": "market.kettle.compared",
              "value": true
            }
          ]
        },
        {
          "text": "Keep the ferry card folded."
        }
      ]
    },
    {
      "id": "market.kettle.place",
      "speaker": "market-clerk",
      "historicalLabel": "fictional-world",
      "text": "“I can give the carrier one sheet with two sections, or leave a tally on the rain shelf where the remaining two wait. The shelf helps a second carrier find the pair. One sheet travels with the first.”",
      "options": [
        {
          "text": "Give the carrier a folded card with ready and received on separate sides.",
          "if": {
            "objective": "market.kettle.compare"
          },
          "effects": [
            {
              "setFlag": "market.kettle.layout",
              "value": "fold"
            }
          ]
        },
        {
          "text": "Leave the two pending spaces marked at the covered table.",
          "if": {
            "objective": "market.kettle.compare"
          },
          "effects": [
            {
              "setFlag": "market.kettle.layout",
              "value": "table"
            }
          ]
        },
        {
          "text": "Leave the covered table clear for now."
        }
      ]
    }
  ],
  "journal": [
    {
      "id": "j.kettle.served",
      "claimKind": "interpretation",
      "text": "I kept the six serving measures together and marked separately when people collected their cups. Another shift can have the same stock and leave at a different bell."
    }
  ],
