{
  "dialogue": [
    {
      "id": "spare-seat.test",
      "speaker": "narrator",
      "text": "The archive has one spare reading stand. Its draft promise reads, “Bring a blue peg and the stand is yours.” Two waiting slips are clipped to different test tabs.",
      "historicalLabel": "fictional-world",
      "effects": [
        {
          "setFlag": "spare-seat.started",
          "value": true
        }
      ],
      "options": [
        {
          "text": "Fit yesterday’s blue peg next to its return slip.",
          "effects": [
            {
              "setFlag": "spare-seat.tab",
              "value": "peg"
            }
          ]
        },
        {
          "text": "Slide Elos’s current request into the empty peg slot.",
          "effects": [
            {
              "setFlag": "spare-seat.tab",
              "value": "request"
            }
          ]
        },
        {
          "text": "Leave the stand at rest."
        }
      ]
    },
    {
      "id": "spare-seat.post",
      "speaker": "narrator",
      "text": "Marek lays yesterday’s handback beside Elos’s current request. The peg works as a loan trace. He needs a rule that helps people use the spare stand. He can staff the rail at each bell or use the rail for checked requests between bells.",
      "historicalLabel": "fictional-world",
      "options": [
        {
          "text": "Hang a rail for checked current requests in order.",
          "effects": [
            {
              "setFlag": "spare-seat.rule",
              "value": "public"
            }
          ]
        },
        {
          "text": "Seat the keeper at the rail to hear requests the slips missed.",
          "effects": [
            {
              "setFlag": "spare-seat.rule",
              "value": "staffed"
            }
          ]
        },
        {
          "text": "Leave the draft open until the next bell."
        }
      ]
    },
    {
      "id": "spare-seat.carry",
      "speaker": "narrator",
      "text": "The working copy gives both tests and your rule. Marek leaves room for another keeper to say what their own mark proves.",
      "historicalLabel": "fictional-world",
      "options": [
        {
          "text": "Take the checked loan warrant for a later service desk.",
          "effects": [
            {
              "giveItem": "item.spare-seat.warrant"
            }
          ]
        },
        {
          "text": "Leave the warrant on the copying hook."
        }
      ]
    },
    {
      "id": "spare-seat.desk",
      "speaker": "narrator",
      "text": "Lin marks both arrivals on the same service sheet. One cart stop remains in this practice run. You can keep the first-bell stop and file a referral, or move the one stop to the lower rail after handover.",
      "historicalLabel": "fictional-world",
      "options": [
        {
          "text": "Keep the first-bell stop and send Siven’s open request to the staffed rail.",
          "effects": [
            {
              "setFlag": "spare-seat.plan",
              "value": "leave"
            }
          ]
        },
        {
          "text": "Move the stop to the lower rail at the second bell and hold the other parcel for tomorrow.",
          "effects": [
            {
              "setFlag": "spare-seat.plan",
              "value": "move"
            }
          ]
        },
        {
          "text": "Leave the service sheet open."
        }
      ]
    }
  ],
