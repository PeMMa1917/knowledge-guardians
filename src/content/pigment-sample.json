  "hints": [
    {
      "id": "h.pigment-sample.compared.1",
      "objective": "pigment-sample.compared",
      "depth": 1,
      "text": "The new wrapper by the reed-violet frame came from a different drying day."
    },
    {
      "id": "h.pigment-sample.compared.2",
      "objective": "pigment-sample.compared",
      "depth": 2,
      "text": "Check the loan number through the glass. Then look at the signed wrapper on the next stand."
    },
    {
      "id": "h.pigment-sample.compared.3",
      "objective": "pigment-sample.compared",
      "depth": 3,
      "text": "The older strip is W27. Nell authorises study only on the separate R13 workshop swatch."
    },
    {
      "id": "h.pigment-sample.compared.4",
      "objective": "pigment-sample.compared",
      "depth": 4,
      "text": "Match the two marked numbers at the sealed window, then take the signed R13 wrapper from its tray."
    },
    {
      "id": "h.pigment-sample.reconciled.1",
      "objective": "pigment-sample.reconciled",
      "depth": 1,
      "text": "Think of the reader arriving tomorrow. Which evidence will still be there?"
    },
    {
      "id": "h.pigment-sample.reconciled.2",
      "objective": "pigment-sample.reconciled",
      "depth": 2,
      "text": "At the bench you can send R13 for a report or leave it whole. Walk to the place that receives it."
    },
    {
      "id": "h.pigment-sample.reconciled.3",
      "objective": "pigment-sample.reconciled",
      "depth": 3,
      "text": "A report describes material that is gone. A whole strip supports a new edge check. The older W27 loan has its own limit either way."
    },
    {
      "id": "h.pigment-sample.reconciled.4",
      "objective": "pigment-sample.reconciled",
      "depth": 4,
      "text": "Read the outcome at the report peg or comparison tray. Return to the caption bench to separate W27 and R13, then check the next reader’s copy."
    }
  ],
