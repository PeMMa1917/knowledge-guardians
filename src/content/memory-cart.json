  "dialogue": [
    {
      "id": "memory-cart.first.wheel",
      "speaker": "narrator",
      "historicalLabel": "fictional-world",
      "text": "The handcart rolls across the white chalk bar. A fresh tread lands on the far side. From this opening, the rail hides the crate.",
      "options": [
        {
          "text": "Clip the wheel’s path to the bottom peg.",
          "effects": [
            {
              "setFlag": "memory-cart.first",
              "value": "wheel"
            },
            {
              "journal": "j.memory-cart.first.wheel"
            }
          ],
          "if": {
            "not": {
              "flagSet": "memory-cart.first"
            }
          }
        },
        {
          "text": "Keep walking."
        }
      ],
      "claimKind": "observation"
    },
    {
      "id": "memory-cart.first.strap",
      "speaker": "narrator",
      "historicalLabel": "fictional-world",
      "text": "The blue cord runs through the yellow crate’s eye and the cart’s peg. It keeps its closed loop while the cart passes this opening. The stones hide the far wheel.",
      "options": [
        {
          "text": "Clip the blue cord’s closed loop to the bottom peg.",
          "effects": [
            {
              "setFlag": "memory-cart.first",
              "value": "strap"
            },
            {
              "journal": "j.memory-cart.first.strap"
            }
          ],
          "if": {
            "not": {
              "flagSet": "memory-cart.first"
            }
          }
        },
        {
          "text": "Keep walking."
        }
      ],
      "claimKind": "observation"
    },
    {
      "id": "memory-cart.launch.wheel",
      "speaker": "narrator",
      "historicalLabel": "fictional-world",
      "text": "Wait behind the chalk-bar opening. Lower the wooden stop so the handcart can pass your side.",
      "options": [
        {
          "text": "Lower the stop and watch the wheels.",
          "effects": [
            {
              "setFlag": "memory-cart.open.wheel",
              "value": true
            }
          ],
          "if": {
            "not": {
              "flagSet": "memory-cart.first"
            }
          }
        },
        {
          "text": "Leave the stop in place."
        }
      ]
    },
    {
      "id": "memory-cart.launch.strap",
      "speaker": "narrator",
      "historicalLabel": "fictional-world",
      "text": "Wait by the crate’s eyelet. Lower the wooden stop before the cart reaches this opening.",
      "options": [
        {
          "text": "Lower the stop and watch the blue cord.",
          "effects": [
            {
              "setFlag": "memory-cart.open.strap",
              "value": true
            }
          ],
          "if": {
            "not": {
              "flagSet": "memory-cart.first"
            }
          }
        },
        {
          "text": "Leave the stop in place."
        }
      ]
    },
    {
      "id": "memory-cart.guide",
      "speaker": "memory-cart-edrin",
      "historicalLabel": "fictional-world",
      "text": "It stopped at this rail. I can practically see the hand lifting that yellow crate. A porter at our table said he saw it too. Keep the west checker’s slip off my rack. Their crew always makes trouble over our stops.",
      "options": [
        {
          "text": "Lay Edrin’s slip over my first sketch for now.",
          "effects": [
            {
              "setFlag": "memory-cart.working",
              "value": "over"
            },
            {
              "journal": "j.memory-cart.guide"
            }
          ],
          "if": {
            "not": {
              "flagSet": "memory-cart.working"
            }
          }
        },
        {
          "text": "Clip Edrin’s slip beside my first sketch.",
          "effects": [
            {
              "setFlag": "memory-cart.working",
              "value": "beside"
            },
            {
              "journal": "j.memory-cart.guide"
            }
          ],
          "if": {
            "not": {
              "flagSet": "memory-cart.working"
            }
          }
        },
        {
          "text": "Leave both slips loose for now."
        }
      ],
      "claimKind": "interpretation"
    },
    {
      "id": "memory-cart.clip",
      "speaker": "memory-cart-nella",
      "historicalLabel": "fictional-world",
      "text": "Edrin closed this flap over the west checker’s slot. The string holds a note that says every west slip should be discarded before it is read. I fetched their tread strip anyway.",
      "options": [
        {
          "text": "Untie the flap and open the west checker’s slot.",
          "effects": [
            {
              "setFlag": "memory-cart.clip",
              "value": true
            },
            {
              "journal": "j.memory-cart.clip"
            }
          ],
          "if": {
            "all": [
              {
                "flag": "memory-cart.notice",
                "eq": true
              },
              {
                "not": {
                  "flag": "memory-cart.clip",
                  "eq": true
                }
              }
            ]
          }
        },
        {
          "text": "Leave the flap as it is."
        }
      ]
    },
    {
      "id": "memory-cart.wheel",
      "speaker": "memory-cart-nella",
      "historicalLabel": "fictional-world",
      "text": "The old strip stayed on the west peg. I can roll the little cart past the same bar to lay down a second tread. You can compare them from the west opening.",
      "options": [
        {
          "text": "Open the west view and roll the cart across the bar.",
          "effects": [
            {
              "setFlag": "memory-cart.replay.wheel",
              "value": true
            }
          ],
          "if": {
            "flag": "memory-cart.clip",
            "eq": true
          }
        },
        {
          "text": "Keep the wheel at the start."
        }
      ]
    },
    {
      "id": "memory-cart.strap",
      "speaker": "memory-cart-nella",
      "historicalLabel": "fictional-world",
      "text": "I can tie the cord through the same two places and make the pass again. Watch the loop from here. You can keep your eyes on it past the opening.",
      "options": [
        {
          "text": "Set the crate on its pegged cord and replay the pass.",
          "effects": [
            {
              "setFlag": "memory-cart.replay.strap",
              "value": true
            }
          ]
        },
        {
          "text": "Leave the crate tied here."
        }
      ]
    },
    {
      "id": "memory-cart.publish",
      "speaker": "memory-cart-edrin",
      "historicalLabel": "fictional-world",
      "text": "That tread comes from your replay. I can still picture a hand on the crate. The porter told me about the hand after the pass. I had supplied the stop myself. Will you put up what we checked, or take someone through it with Nella?",
      "options": [
        {
          "text": "Post the two checked limits and send the collector to the gate tray.",
          "effects": [
            {
              "setFlag": "memory-cart.plan",
              "value": "direct"
            },
            {
              "journal": "j.memory-cart.choice.direct"
            }
          ],
          "if": {
            "all": [
              {
                "objective": "memory-cart.sources"
              },
              {
                "not": {
                  "flagSet": "memory-cart.plan"
                }
              }
            ]
          }
        },
        {
          "text": "Keep the reported stop in its own sleeve and send the collector with Nella.",
          "effects": [
            {
              "setFlag": "memory-cart.plan",
              "value": "escort"
            },
            {
              "journal": "j.memory-cart.choice.escort"
            }
          ],
          "if": {
            "all": [
              {
                "objective": "memory-cart.sources"
              },
              {
                "not": {
                  "flagSet": "memory-cart.plan"
                }
              }
            ]
          }
        },
        {
          "text": "Keep the rail open while I think."
        }
      ],
      "claimKind": "interpretation"
    }
  ],
