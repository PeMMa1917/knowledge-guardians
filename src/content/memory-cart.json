  "hints": [
    {
      "id": "h.memory-cart.initial.1",
      "objective": "memory-cart.initial",
      "depth": 1,
      "text": "Look for the two openings near the south approach."
    },
    {
      "id": "h.memory-cart.initial.2",
      "objective": "memory-cart.initial",
      "depth": 2,
      "text": "Each opening shows a different part of the same cart pass."
    },
    {
      "id": "h.memory-cart.initial.3",
      "objective": "memory-cart.initial",
      "depth": 3,
      "text": "Choose one opening and keep its working sketch on a bottom peg."
    },
    {
      "id": "h.memory-cart.initial.4",
      "objective": "memory-cart.initial",
      "depth": 4,
      "text": "Use the chalk-bar view west of the south steps, or the blue-cord view to the east. Clip the first view."
    },
    {
      "id": "h.memory-cart.sources.1",
      "objective": "memory-cart.sources",
      "depth": 1,
      "text": "The visible event and the story told afterwards have their own places."
    },
    {
      "id": "h.memory-cart.sources.2",
      "objective": "memory-cart.sources",
      "depth": 2,
      "text": "Read why the delivery stopped at the covered stall. The west slot’s flap has a different reason for being shut."
    },
    {
      "id": "h.memory-cart.sources.3",
      "objective": "memory-cart.sources",
      "depth": 3,
      "text": "Open the flap. Replay the chalk view and the cord view. Read the first sketch in its own place."
    },
    {
      "id": "h.memory-cart.sources.4",
      "objective": "memory-cart.sources",
      "depth": 4,
      "text": "Talk to Edrin, look at the covered-stall notice, then ask Nella to untie the west slot. Check each replay and the retained original before using the south-rail publication desk."
    },
    {
      "id": "h.memory-cart.handover.1",
      "objective": "memory-cart.handover",
      "depth": 1,
      "text": "A collector can use either of the checked instructions."
    },
    {
      "id": "h.memory-cart.handover.2",
      "objective": "memory-cart.handover",
      "depth": 2,
      "text": "A direct notice makes progress fast. An escort gives another person a turn to check."
    },
    {
      "id": "h.memory-cart.handover.3",
      "objective": "memory-cart.handover",
      "depth": 3,
      "text": "The posted instruction and the keeper’s escort leave their replies in different places."
    },
    {
      "id": "h.memory-cart.handover.4",
      "objective": "memory-cart.handover",
      "depth": 4,
      "text": "Use Edrin’s rack, choose a direct collector or an escort with Nella, then check the gate tray to the west or Nella’s escorted handoff to the east."
    }
  ],
  "journal": [
    {
      "id": "j.memory-cart.first.wheel",
      "text": "First peg. The wheel laid a tread beyond the chalk bar. The rail hid the crate.",
      "claimKind": "observation"
    },
    {
      "id": "j.memory-cart.first.strap",
      "text": "First peg. The cord stayed closed through the crate’s eye and the cart peg at this opening. The stones hid the far wheel.",
      "claimKind": "observation"
    },
    {
      "id": "j.memory-cart.guide",
      "text": "Edrin’s report of a stop sat with the earlier sketch. He heard the detail about a hand from a porter after the pass.",
      "claimKind": "interpretation"
    },
    {
      "id": "j.memory-cart.clip",
      "text": "The covered stall missed a delivery of the west slip. Edrin’s tied flap deliberately kept later west slips off his rack.",
      "claimKind": "observation"
    },
    {
      "id": "j.memory-cart.sources",
      "text": "On replay the tread extended beyond the bar. At the other opening the crate loop stayed tied. The first view still has its own peg.",
      "claimKind": "observation"
    },
    {
      "id": "j.memory-cart.choice.direct",
      "text": "The next collector gets both checked limits on a direct notice. The reported stop stays with the named recollection.",
      "claimKind": "value"
    },
    {
      "id": "j.memory-cart.choice.escort",
      "text": "Nella takes one collector through both viewpoints. The report of the stop keeps its own sleeve.",
      "claimKind": "value"
    },
    {
      "id": "j.memory-cart.handover",
      "text": "The receiver used a fresh checked instruction. The reported stop and each observer’s limits still have their place.",
      "claimKind": "observation"
    }
  ]
}
