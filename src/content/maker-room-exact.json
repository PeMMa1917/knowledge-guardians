    {
      "id": "card.makers.exact.disk",
      "title": "Disc of Enheduanna",
      "text": "The Penn Museum dates this limestone or calcite disk from Ur to about 2300 BCE. It records a relief on one side and an inscription on the other naming Enheduanna and identifying her as the daughter of Sargon.",
      "limits": "The inscription identifies Enheduanna. The disk alone gives no surviving manuscript in her hand and no proof of who composed a particular hymn.",
      "claimKind": "observation",
      "historicalLabel": "documented",
      "sources": [
        "HIS-ENHEDUANNA-DISK"
      ]
    },
    {
      "id": "card.makers.exact.laguna",
      "title": "Laguna Copperplate Inscription",
      "text": "The National Museum records this inscribed copperplate from the Pagsanjan River Delta, Laguna, with the date 900 CE. In Postma’s preliminary reading, a document clears a debt associated with Namwran. Angkatan, Bukah and the witness Kasumuran appear in the reading.",
      "limits": "The preliminary reading names a person, a clearance and witnesses. It leaves their individual voices and any later otherwise unrecorded debt open.",
      "claimKind": "observation",
      "historicalLabel": "documented",
      "sources": [
        "HIS-LAGUNA-HOLDING",
        "HIS-LAGUNA-READING"
      ]
    }
  ],
