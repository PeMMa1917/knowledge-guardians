{
  "dialogue": [
    {
      "id": "pigment-window.try",
      "speaker": "narrator",
      "text": "The dry practice strips sit in a sealed picture frame. The reading is the brightness of each reed-violet patch against the marked scale. Move one control at a time.",
      "historicalLabel": "fictional-world",
      "options": [
        {
          "text": "Slide the intact strip under the warm lamp.",
          "effects": [
            {
              "setFlag": "pigment-window.display",
              "value": "warm"
            }
          ]
        },
        {
          "text": "Slide the same intact strip under the cool lamp.",
          "effects": [
            {
              "setFlag": "pigment-window.display",
              "value": "cool"
            }
          ]
        },
        {
          "text": "Set both custody strips under the same cool lamp at the start.",
          "effects": [
            {
              "setFlag": "pigment-window.display",
              "value": "start"
            }
          ]
        },
        {
          "text": "Advance the model’s custody interval and keep the cool lamp fixed.",
          "effects": [
            {
              "setFlag": "pigment-window.display",
              "value": "later"
            }
          ],
          "if": {
            "flag": "pigment-window.seen.start",
            "eq": true
          }
        },
        {
          "text": "Leave the frame open for another reader."
        }
      ],
      "effects": [
        {
          "setFlag": "pigment-window.started",
          "value": true
        }
      ]
    },
    {
      "id": "pigment-window.copy",
      "speaker": "copies-lendingkeeper",
      "text": "Your strip shows how much the lamp alone changes the reading. It also shows a change in the exposed practice patch under the same lamp. I need a proof customers can use at the landing.",
      "historicalLabel": "fictional-world",
      "options": [
        {
          "text": "Hang the two reference marks under one fixed lamp.",
          "effects": [
            {
              "setFlag": "pigment-window.placement",
              "value": "lamp"
            }
          ]
        },
        {
          "text": "Ink a hatch marker beside the colour for readers on the outdoor path.",
          "effects": [
            {
              "setFlag": "pigment-window.placement",
              "value": "hatch"
            }
          ]
        },
        {
          "text": "Come back with the proof another time."
        }
      ]
    },
    {
      "id": "pigment-window.take",
      "speaker": "narrator",
      "historicalLabel": "fictional-world",
      "text": "The lamp check compares one strip under two lights. The custody check uses one light on both strips at two times. The clerk has clipped both readings to a copy for the Lending Hall.",
      "options": [
        {
          "text": "Tuck the paired pigment proof into the bag.",
          "effects": [
            {
              "giveItem": "item.pigment-window.strip"
            }
          ]
        },
        {
          "text": "Leave the copy on the bench for now."
        }
      ]
    }
  ],
