  "hints": [
    {
      "id": "h.claimbell.well.word.1",
      "objective": "claimbell.well.word",
      "depth": 1,
      "text": "Someone has drawn a cup beside the well."
    },
    {
      "id": "h.claimbell.well.word.2",
      "objective": "claimbell.well.word",
      "depth": 2,
      "text": "Efua has a second pot behind the reserved jug."
    },
    {
      "id": "h.claimbell.well.word.3",
      "objective": "claimbell.well.word",
      "depth": 3,
      "text": "Look for the brass plate near the east depth stick."
    },
    {
      "id": "h.claimbell.well.word.4",
      "objective": "claimbell.well.word",
      "depth": 4,
      "text": "At the spare pot, turn the brass word plate."
    },
    {
      "id": "h.claimbell.well.test.1",
      "objective": "claimbell.well.test",
      "depth": 1,
      "text": "The soup and the ridge cart come in at different bells."
    },
    {
      "id": "h.claimbell.well.test.2",
      "objective": "claimbell.well.test",
      "depth": 2,
      "text": "A request can arrive before its owner."
    },
    {
      "id": "h.claimbell.well.test.3",
      "objective": "claimbell.well.test",
      "depth": 3,
      "text": "Fit a voice, tally or neighbour to the hatch. Set the bell."
    },
    {
      "id": "h.claimbell.well.test.4",
      "objective": "claimbell.well.test",
      "depth": 4,
      "text": "Walk with each caller. Change the bell and see whose name arrives."
    },
    {
      "id": "h.claimbell.issue.1",
      "objective": "claimbell.issue",
      "depth": 1,
      "text": "What follows from counting only the voices we can hear?"
    },
    {
      "id": "h.claimbell.issue.2",
      "objective": "claimbell.issue",
      "depth": 2,
      "text": "Try two entrances. The porter wants to test the speaking window himself."
    },
    {
      "id": "h.claimbell.issue.3",
      "objective": "claimbell.issue",
      "depth": 3,
      "text": "Test both neighbours with the exact entrance and bell you plan to send."
    },
    {
      "id": "h.claimbell.issue.4",
      "objective": "claimbell.issue",
      "depth": 4,
      "text": "Walk the porter through the speaking window, try a second entrance and walk both callers with your final fittings. Seal the rule."
    },
    {
      "id": "h.claimbell.home.1",
      "objective": "claimbell.home",
      "depth": 1,
      "text": "An entrance that suited the weir can feel different on the ridge."
    },
    {
      "id": "h.claimbell.home.2",
      "objective": "claimbell.home",
      "depth": 2,
      "text": "The porter has kept his cup."
    },
    {
      "id": "h.claimbell.home.3",
      "objective": "claimbell.home",
      "depth": 3,
      "text": "Return to the spare pot near Efua’s depth stick after signing at the yard."
    },
    {
      "id": "h.claimbell.home.4",
      "objective": "claimbell.home",
      "depth": 4,
      "text": "At the spare pot give the returning porter the council rule. Read whose claim made it through."
    },
    {
      "id": "h.claimbell.receive.1",
      "objective": "claimbell.receive",
      "depth": 1,
      "text": "Look for a wet handprint on a desk."
    },
    {
      "id": "h.claimbell.receive.2",
      "objective": "claimbell.receive",
      "depth": 2,
      "text": "The crest on Efua’s seal belongs beside the weir."
    },
    {
      "id": "h.claimbell.receive.3",
      "objective": "claimbell.receive",
      "depth": 3,
      "text": "Find the wet handprint in the Council Yard, beyond the Old Weir."
    },
    {
      "id": "h.claimbell.receive.4",
      "objective": "claimbell.receive",
      "depth": 4,
      "text": "Break Efua’s paper seal and read the old entrance and bell."
    },
    {
      "id": "h.claimbell.weir.word.1",
      "objective": "claimbell.weir.word",
      "depth": 1,
      "text": "There’s a wet handprint below the sill."
    },
    {
      "id": "h.claimbell.weir.word.2",
      "objective": "claimbell.weir.word",
      "depth": 2,
      "text": "Can someone tell us about the wheel with their eyes shut?"
    },
    {
      "id": "h.claimbell.weir.word.3",
      "objective": "claimbell.weir.word",
      "depth": 3,
      "text": "The copper fitting on the yard desk has two faces."
    },
    {
      "id": "h.claimbell.weir.word.4",
      "objective": "claimbell.weir.word",
      "depth": 4,
      "text": "At the council hatch, turn the brass word plate."
    },
    {
      "id": "h.claimbell.weir.test.1",
      "objective": "claimbell.weir.test",
      "depth": 1,
      "text": "Which account even gets as far as the clerk?"
    },
    {
      "id": "h.claimbell.weir.test.2",
      "objective": "claimbell.weir.test",
      "depth": 2,
      "text": "The listener and the chalk maker finish at different times."
    },
    {
      "id": "h.claimbell.weir.test.3",
      "objective": "claimbell.weir.test",
      "depth": 3,
      "text": "The sealed rule at the bottom shows Efua’s fittings."
    },
    {
      "id": "h.claimbell.weir.test.4",
      "objective": "claimbell.weir.test",
      "depth": 4,
      "text": "Set the same entrance and bell as the sealed rule. Walk both workers through it."
    },
    {
      "id": "h.claimbell.sign.1",
      "objective": "claimbell.sign",
      "depth": 1,
      "text": "The empty slot and the three knocks tell different stories."
    },
    {
      "id": "h.claimbell.sign.2",
      "objective": "claimbell.sign",
      "depth": 2,
      "text": "Compare the wheel listener at the tally slot and at the speaking window after her shift."
    },
    {
      "id": "h.claimbell.sign.3",
      "objective": "claimbell.sign",
      "depth": 3,
      "text": "Try the original well rule with both workers. Choose how the council should receive their accounts."
    },
    {
      "id": "h.claimbell.sign.4",
      "objective": "claimbell.sign",
      "depth": 4,
      "text": "Walk the listener through the tally slot, then the closing speaking window. Test both workers with your chosen rule, sign it and take it home."
    }
  ]
