{
  "name": "knowledge-guardians",
  "private": true,
  "version": "0.1.0",
  "description": "A fifteen-chapter pixel-art RPG for IB Theory of Knowledge.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:collectibles": "node tools/audit-collectible-use.mjs --require-all",
    "check:chapters": "node tools/check-chapter-delivery.mjs",
    "validate:content": "vitest run tests/content.test.ts",
    "assets:variants": "python3 tools/make_character_variants.py",
    "assets:check": "node tools/check-assets.mjs"
  },
  "dependencies": {
    "@fontsource/lexend": "5.3.0",
    "fflate": "0.8.2",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
